# PostgreSQL
DATABASE_URL=postgresql+asyncpg://syn:syn@localhost:5433/syn

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_TRIALS_COLLECTION=syn_trials
QDRANT_PAPERS_COLLECTION=syn_papers

# Redis
REDIS_URL=redis://localhost:6379

# NCBI / PubMed (use your real contact email for NCBI requests)
NCBI_EMAIL=your-email@example.com
NCBI_API_KEY=

# Optional generation, figure analysis and publication
GROQ_API_KEY=
OPENAI_API_KEY=
VISION_PROVIDER=groq
NOTION_TOKEN=
NOTION_REPORTS_DB_ID=
DISCORD_WEBHOOK_URL=

# Embedding
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# App
ENVIRONMENT=development
ENABLE_SCHEDULER=false
INTERNAL_API_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000
